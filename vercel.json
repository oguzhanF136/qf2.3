{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/api/binance/(.*)",
      "dest": "https://api.binance.com/api/v3/$1"
    },
    {
      "src": "/api/futures/(.*)",
      "dest": "https://fapi.binance.com/fapi/v1/$1"
    }
  ]
} 